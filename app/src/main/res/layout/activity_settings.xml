<?xml version="1.0" encoding="utf-8"?>
<!-- SettingsActivity — Claude AI features: API key, model, local cost monitor. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖  Ustawienia AI"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opcjonalne funkcje oparte na Claude (wyjaśnianie kodów błędów, analiza skanowania ECU). Klucz pozostaje tylko w telefonie."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"/>

        <!-- API key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KLUCZ API ANTHROPIC"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="sk-ant-..."
                android:textColor="#FFFFFF"
                android:textColorHint="#3A4A5C"
                android:inputType="textPassword"
                android:maxLines="1"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Klucz uzyskasz na console.anthropic.com → API Keys"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODEL"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

        <Spinner
            android:id="@+id/spModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"/>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Zapisz"
                app:backgroundTint="@color/dpf_blue_light"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Testuj połączenie"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/dpf_orange"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border"
            android:layout_marginVertical="20dp"/>

        <!-- Cost monitor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰  ZUŻYCIE (SZACUNEK LOKALNY)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zapytania: 0"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tokeny: 0 wej. / 0 wyj."
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Szacowany koszt łącznie: $0.0000"
            android:textColor="#34C759"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvLastCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ostatnie zapytanie: $0.0000"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zeruj liczniki"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/status_danger"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koszt to lokalny szacunek na podstawie tokenów każdej odpowiedzi. Oficjalne rozliczenie jest w Konsoli Anthropic."
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
