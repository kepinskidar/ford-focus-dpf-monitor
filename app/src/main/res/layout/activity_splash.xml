<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen layout.
    All views start INVISIBLE — SplashActivity animates them in sequence.
    Background is true black for AMOLED pixel savings.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- App icon (rounded square, transparent corners) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/splashIcon"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/ic_mk5_dpf"
        android:scaleType="fitCenter"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splashTitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.42"
        android:contentDescription="Ikona MK5 DPF"/>

    <!-- App name -->
    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MK5 DPF"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:alpha="0"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splashIcon"
        app:layout_constraintBottom_toTopOf="@id/splashSubtitle"/>

    <!-- Car subtitle -->
    <TextView
        android:id="@+id/splashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ford Mondeo Mk5 · 2.0 EcoBlue 190 KM"
        android:textColor="#4F8EF7"
        android:textSize="15sp"
        android:letterSpacing="0.04"
        android:alpha="0"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splashTitle"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Thin accent line above credits -->
    <View
        android:id="@+id/splashDivider"
        android:layout_width="48dp"
        android:layout_height="1dp"
        android:background="#4F8EF7"
        android:alpha="0"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splashCredits"/>

    <!-- Developed by -->
    <TextView
        android:id="@+id/splashCredits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Autor oryginału: Andrea Sesuru"
        android:textColor="#6A7D90"
        android:textSize="13sp"
        android:letterSpacing="0.04"
        android:alpha="0"
        android:layout_marginBottom="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
